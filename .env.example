# ==============================================================================
# ProjectFlow - Archivo de Configuración de Entorno (.env.example)
# Copia este archivo a `.env` y configura tus valores para desarrollo o producción.
# ==============================================================================

# Clave secreta de Django (Generar una aleatoria y única en producción)
SECRET_KEY=django-insecure-projectflow-super-secret-key-change-in-production-2026

# Modo depuración (True para desarrollo local, False para producción)
DEBUG=True

# Hosts permitidos separados por coma (ej. localhost,127.0.0.1,.midominio.com)
ALLOWED_HOSTS=localhost,127.0.0.1

# ==============================================================================
# CONFIGURACIÓN DE BASE DE DATOS
# ==============================================================================
# Opciones para DB_ENGINE:
# - django.db.backends.postgresql (Recomendado para producción / PostgreSQL)
# - django.db.backends.sqlite3 (Por defecto para desarrollo rápido)
DB_ENGINE=django.db.backends.sqlite3

# Parámetros para PostgreSQL (cuando DB_ENGINE=django.db.backends.postgresql)
DB_NAME=projectflow_db
DB_USER=postgres
DB_PASSWORD=postgres_password
DB_HOST=127.0.0.1
DB_PORT=5432
